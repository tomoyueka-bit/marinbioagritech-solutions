<h3>4. Support</h3><p>Provide guidance, monitoring and maintenance arrangements.</p></div></div></div></section>${quoteBand(s.title.toLowerCase()+' requirements')}`}
function technology(){return pageHero('BioVitalix SmartGrow™','The planned digital operating system for biological agriculture.',images.technology)+`<section class="section"><div class="container split"><div><span class="eyebrow">In development</span><h2>Biology powered by data.</h2><p class="lead">SmartGrow is planned to connect farmer profiles, BioVitalix recommendations, application tracking, crop monitoring, soil-health records, traceability and institutional reporting.</p></div><div class="card"><h3>Planned modules</h3><ul class="check"><li>Farmer and farm dashboard</li><li>BioVitalix recommendation engine</li><li>Soil-health intelligence</li><li>Crop monitoring</li><li>Research and institutional reporting</li><li>Dealer and product traceability</li></ul></div></div></section><section class="section soft"><div class="container"><div class="grid g4"><div class="card"><span class="pill">Phase 1</span><h3 style="margin-top:14px">Product success loop</h3><p>Farmer baseline, recommendation, application and monitored observations.</p></div><div class="card"><span class="pill">Phase 2</span><h3 style="margin-top:14px">Commercial operations</h3><p>Product batches, dealers and customer-support workflows.</p></div><div class="card"><span class="pill">Phase 3</span><h3 style="margin-top:14px">Institutional intelligence</h3><p>Projects, adoption and anonymized impact reporting.</p></div><div class="card"><span class="pill">Future</span><h3 style="margin-top:14px">Predictive intelligence</h3><p>Evidence-based recommendations after sufficient verified data exists.</p></div></div></div></section>${quoteBand('a SmartGrow development or data partnership')}`}
function projects(){return pageHero('Projects','Verified project stories will document the challenge, solution, scope and outcomes.',images.farm)+`<section class="section"><div class="container"><span class="eyebrow">Project portfolio</span><h2>Evidence-led project documentation.</h2><div class="notice">Client names, locations, outcomes and testimonials will only be published after MarinBio verifies the information and secures permission.</div><div class="grid g3" style="margin-top:25px"><div class="card"><span class="pill">Framework</span><h3 style="margin-top:15px">Biological agriculture demonstration hubs</h3><p>A project-page framework for technology validation, farmer learning and youth enterprise development.</p></div><div class="card"><span class="pill">Future project</span><h3 style="margin-top:15px">Controlled-environment installations</h3><p>Reserved for verified hydroponic, aeroponic and aquaponic projects.</p></div><div class="card"><span class="pill">Future project</span><h3 style="margin-top:15px">Circular waste systems</h3><p>Reserved for verified BSF and organic-resource valorization projects.</p></div></div></div></section>${quoteBand('a technology deployment or demonstration project')}`}
function research(){return pageHero('Research','Evidence before exaggeration.',images.soil)+`<section class="section"><div class="container split"><div><span class="eyebrow">Scientific credibility</span><h2>Validation is part of the product.</h2><p class="lead">MarinBio’s research agenda focuses on product validation, soil-health testing, crop-response monitoring, responsible claims and transparent reporting.</p><ul class="check"><li>Field trials and demonstration farms</li><li>Laboratory and soil analysis</li><li>Crop observations and agronomist review</li><li>University and research collaboration</li><li>Data ethics and responsible communication</li></ul></div><div class="card"><h3>Claims library</h3><p>Future technical documentation should distinguish approved claims, pilot observations, research hypotheses, restricted language and regulatory status.</p></div></div></section>${quoteBand('a BioVitalix research or validation partnership')}`}
const articles=[{slug:'soil-is-a-living-system',title:'Soil Is a Living System',cat:'Soil health',text:'Regenerative agriculture starts by understanding the relationships among roots, organic matter, microorganisms, water and farm management.'},{slug:'circular-bioeconomy-agriculture',title:'The Circular Bioeconomy Opportunity',cat:'Circular bioeconomy',text:'Agricultural and organic resources can be redirected into biological products, enterprise opportunities and more resilient production systems.'},{slug:'controlled-environment-agriculture',title:'Choosing a Controlled-Environment System',cat:'Farm technology',text:'Hydroponics, aeroponics and aquaponics solve different problems. The right choice depends on crop, scale, water, skills and market.'}];
function insights(){return pageHero('Insights','Practical thinking on biological agriculture, soil health, circular systems and farm technology.',images.training)+`<section class="section"><div class="container"><div class="grid g3">${articles.map(a=>`<article class="card"><span class="pill">${a.cat}</span><h3 style="margin-top:15px">${a.title}</h3><p>${a.text}</p><a class="link" href="/insights/${a.slug}">Read article →</a></article>`).join('')}</div></div></section>`}
function article(slug){const a=articles.find(x=>x.slug===slug);if(!a)return notFound();return pageHero(a.title,a.text,images.soil)+`<section class="section"><article class="container article"><span class="pill">${a.cat}</span><h2>Why this matters</h2><p>${a.text}</p><p>MarinBio approaches this subject through a combination of biological science, practical agricultural engineering, farmer learning and responsible evidence generation.</p><h2>What implementation requires</h2><p>Good outcomes depend on crop choice, site conditions, water, skills, operating discipline and ongoing monitoring. Technologies should be selected because they fit the production problem—not because they are fashionable.</p><h2>MarinBio’s approach</h2><p>Assess the context, design the appropriate intervention, provide practical guidance, monitor results and improve the system using verified evidence.</p></article></section>`}
function gallery(){const items=[['BioVitalix',images.soil],['BSF systems',images.farm],['Hydroponics',images.hydro],['Aeroponics',images.greenhouse],['Aquaponics',images.hydro],['Training',images.training]];return pageHero('Gallery','A visual space for verified MarinBio products, installations, training and research.',images.gree