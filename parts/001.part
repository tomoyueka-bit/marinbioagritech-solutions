ap:15px}.field{display:grid;gap:6px}.full{grid-column:1/-1}.field label{font-weight:850;font-size:.86rem}.field input,.field select,.field textarea{padding:12px;border:1px solid #cbd9d2;border-radius:11px;font:inherit;background:#fcfdfa}.field textarea{min-height:130px}.success{display:none;margin-top:15px;padding:13px;border-radius:11px;background:#e4f3e8;color:var(--green);font-weight:800}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.gallery figure{margin:0;position:relative;overflow:hidden;border-radius:18px;min-height:260px;background:#ddd}.gallery img{width:100%;height:100%;object-fit:cover;position:absolute}.gallery figcaption{position:absolute;inset:auto 0 0;padding:35px 17px 15px;background:linear-gradient(transparent,#071f18d9);color:white;font-weight:800}.filters{display:flex;gap:9px;flex-wrap:wrap;margin:24px 0}.filter{border:1px solid var(--line);background:white;border-radius:999px;padding:9px 13px;cursor:pointer;font-weight:800}.filter.active{background:var(--green);color:white}.article{max-width:820px}.article h2{font-size:2rem;margin-top:40px}.article p{font-size:1.08rem;color:#4f6159}.route-title{max-width:900px}footer{background:#071f18;color:white;padding:60px 0 24px}.footergrid{display:grid;grid-template-columns:1.5fr repeat(4,1fr);gap:32px}.footergrid h4{margin:0 0 13px}.footergrid a{display:block;color:#c0d2ca;padding:4px 0}.footnote{border-top:1px solid #ffffff1e;margin-top:42px;padding-top:20px;display:flex;justify-content:space-between;color:#9cb2a8;font-size:.85rem}.hidden{display:none!important}
@media(max-width:1000px){.navlinks{display:none}.menu{display:block}.g4{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(2,1fr)}.flow{grid-template-columns:repeat(3,1fr)}.footergrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:720px){.topbar .container{display:block}.section{padding:70px 0}.split,.g2,.g3,.g4,.compare,.fields{grid-template-columns:1fr}.flow{grid-template-columns:1fr}.flow div:not(:last-child):after{content:"↓";top:auto;bottom:-18px;right:50%}.quote-band{display:block;padding:30px}.gallery{grid-template-columns:1fr}.footergrid{grid-template-columns:1fr}.footnote{display:block}.hero{min-height:660px}.full{grid-column:auto}}
</style>
</head>
