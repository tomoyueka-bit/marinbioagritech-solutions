lly. Reference: '+ref+'. Secure remote delivery will activate after MarinBio connects a verified inbox or Supabase project.';f.reset()});document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');const v=b.dataset.filter;document.querySelectorAll('.gallery figure').forEach(x=>x.classList.toggle('hidden',v!=='all'&&x.dataset.cat!==v))});if(window.__slides){let i=0;const hero=document.getElementById('hero'),t=document.getElementById('ht'),p=document.getElementById('hp'),c=document.getElementById('hc'),dots=[...document.querySelectorAll('.dot')];function show(n){i=n;const s=window.__slides[i];hero.style.setProperty('--hero',`url('${s.img}')`);t.textContent=s.t;p.textContent=s.p;c.href=s.cta;c.textContent=s.c;dots.forEach((d,x)=>d.classList.toggle('active',x===i))}dots.forEach(d=>d.onclick=()=>show(+d.dataset.slide));show(0);setInterval(()=>show((i+1)%window.__slides.length),6500)}}render();
</script>
</body>
</html>
