<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MarinBio AgritechSolutions | Biological Technology for Regenerative Agriculture</title>
<meta name="description" content="MarinBio AgritechSolutions is a Kenyan biotechnology, circular bioeconomy and climate-smart agriculture company.">
<meta name="theme-color" content="#0b3b2b">
<style>
:root{--green:#0b3b2b;--green2:#146144;--lime:#7bda96;--teal:#218d84;--ink:#14241e;--muted:#687a72;--cream:#f7f3e9;--paper:#fffdf8;--line:#dce6df;--gold:#c5a45a;--danger:#8b4a3a;--max:1180px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 Inter,Segoe UI,Arial,sans-serif}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}.container{width:min(var(--max),calc(100% - 38px));margin:auto}.topbar{background:#071f18;color:#c8dad2;font-size:.78rem;padding:8px 0}.topbar .container{display:flex;justify-content:space-between;gap:20px}.header{position:sticky;top:0;z-index:30;background:#fffdf8ef;backdrop-filter:blur(15px);border-bottom:1px solid #0b3b2b14}.nav{height:78px;display:flex;align-items:center;gap:24px}.brand{font-weight:950;font-size:1.25rem;line-height:1}.brand span{display:block;font-size:.5rem;letter-spacing:.2em;color:var(--muted);margin-top:5px}.navlinks{display:flex;align-items:center;gap:17px;margin-left:auto;font-size:.86rem;font-weight:800}.navlinks>a,.dropbtn{padding:9px 2px;border:0;background:none;font:inherit;color:inherit;cursor:pointer}.bio{background:#e4f4e8!important;border-radius:999px;padding:9px 13px!important;color:var(--green)!important}.quote{background:var(--green);color:white!important;border-radius:999px;padding:12px 17px!important}.dropdown{position:relative}.dropmenu{display:none;position:absolute;top:44px;left:-110px;width:340px;background:white;border:1px solid var(--line);box-shadow:0 24px 70px #092d2029;border-radius:18px;padding:12px}.dropdown:hover .dropmenu,.dropdown:focus-within .dropmenu{display:grid}.dropmenu a{padding:10px 12px;border-radius:11px}.dropmenu a:hover{background:var(--cream)}.menu{display:none;margin-left:auto;background:none;border:1px solid var(--line);padding:9px 13px;border-radius:10px;font-weight:850}.mobile{display:none;position:fixed;inset:78px 0 0;background:var(--paper);z-index:25;padding:20px;overflow:auto}.mobile.open{display:block}.mobile a{display:block;padding:12px;border-bottom:1px solid var(--line);font-weight:800}.mobile .sub{padding-left:28px;font-size:.9rem}.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:900;color:var(--teal)}.eyebrow:before{content:"";width:25px;height:2px;background:var(--lime)}h1,h2,h3{line-height:1.06;letter-spacing:-.04em;margin:0 0 18px}h1{font-size:clamp(3rem,6vw,6.3rem)}h2{font-size:clamp(2.15rem,4vw,4rem)}h3{font-size:1.25rem}.lead{font-size:1.13rem;color:var(--muted);max-width:760px}.section{padding:95px 0}.soft{background:var(--cream)}.dark{background:var(--green);color:white}.dark .lead{color:#cddfd7}.grid{display:grid;gap:22px}.g2{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}.split{display:grid;grid-template-columns:1.08fr .92fr;gap:55px;align-items:center}.card{background:white;border:1px solid var(--line);border-radius:22px;padding:27px;box-shadow:0 14px 42px #0b3b2b0a}.card p{color:var(--muted);margin-bottom:0}.card .link{display:inline-block;margin-top:17px;color:var(--green2);font-weight:900}.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.btn{display:inline-flex;align-items:center;justify-content:center;padding:14px 21px;border-radius:999px;font-weight:900;border:1px solid transparent}.btn-primary{background:var(--lime);color:#08271c}.btn-dark{background:var(--green);color:white}.btn-outline{border-color:#ffffff70;color:white}.btn-line{border-color:var(--green);color:var(--green)}.hero{min-height:710px;color:white;display:grid;align-items:center;position:relative;overflow:hidden;background:linear-gradient(105deg,#071e17dc,#0b3b2ba8),var(--hero) center/cover}.hero:after{content:"";position:absolute;width:540px;height:540px;border-radius:50%;border:1px solid #7bda9633;right:-130px;top:55px;box-shadow:0 0 0 90px #7bda960a,0 0 0 180px #7bda9608}.hero .container{position:relative;z-index:2}.hero p{font-size:1.22rem;max-width:750px;color:#dbe9e3}.dots{display:flex;gap:8px;margin-top:35px}.dot{width:30px;height:4px;background:#ffffff55;border:0;cursor:pointer}.dot.active{background:var(--lime)}.pagehero{padding:115px 0 78px;color:white;background:linear-gradient(100deg,#071f18e8,#0b3b2b9a),var(--bg) center/cover}.crumbs{font-size:.82rem;color:#d0dfd9;margin-bottom:22px}.check{list-style:none;padding:0;margin:22px 0;display:grid;gap:12px}.check li{display:flex;gap:11px}.check li:before{content:"✓";flex:0 0 23px;height:23px;border-radius:50%;display:grid;place-items:center;background:#e5f3e8;color:var(--green);font-weight:950}.flow{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-top:35px}.flow div{background:white;border:1px solid var(--line);border-radius:17px;padding:20px 14px;min-height:130px;font-weight:850;position:relative}.flow b{display:block;color:var(--teal);font-size:.72rem;letter-spacing:.12em;margin-bottom:8px}.flow div:not(:last-child):after{content:"→";position:absolute;right:-11px;top:48%;color:var(--gold)}.compare{display:grid;grid-template-columns:1fr 1fr;gap:22px}.panel{padding:30px;border-radius:22px}.not{background:#f3e9e3}.is{background:#e4f1e8}.pill{display:inline-flex;padding:6px 10px;border-radius:999px;background:#e4f3e8;color:var(--green);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;font-weight:900}.media{border-radius:24px;min-height:430px;object-fit:cover;width:100%}.quote-band{background:var(--green);color:white;border-radius:28px;padding:42px;display:flex;align-items:center;justify-content:space-between;gap:30px}.faq details{background:white;border:1px solid var(--line);border-radius:15px;padding:18px 20px;margin-bottom:11px}.faq summary{font-weight:900;cursor:pointer}.notice{background:#fbf4df;border-left:4px solid var(--gold);padding:18px;border-radius:0 13px 13px 0;color:#69592e}.form{background:white;border:1px solid var(--line);border-radius:24px;padding:28px;box-shadow:0 20px 55px #0b3b2b14}.fields{display:grid;grid-template-columns:1fr 1fr;g