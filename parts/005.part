nhouse)+`<section class="section"><div class="container"><div class="filters"><button class="filter active" data-filter="all">All</button>${items.map(x=>`<button class="filter" data-filter="${x[0]}">${x[0]}</button>`).join('')}</div><div class="gallery">${items.map(x=>`<figure data-cat="${x[0]}"><img src="${x[1]}" alt="Illustrative ${x[0]} image"><figcaption>${x[0]} — illustrative licensed photography</figcaption></figure>`).join('')}</div><div class="notice" style="margin-top:25px">These photographs illustrate solution categories. Replace them with authorized MarinBio project photography as verified assets become available.</div></div></section>`}
function formPage(type){const quote=type==='quote';return pageHero(quote?'Request a Quotation':'Contact MarinBio',quote?'Tell us what you are planning and the solution you need.':'Start a conversation about products, systems, research, training or partnerships.',images.training)+`<section class="section soft"><div class="container split"><div><span class="eyebrow">${quote?'Project inquiry':'Get in touch'}</span><h2>${quote?'Plan the right solution.':'Let us build regenerative agriculture together.'}</h2><p class="lead">Official company email, phone, office location and WhatsApp details will be displayed after verification.</p><div class="notice">The current form creates a local reference number. Secure email or Supabase delivery must be connected before submissions are transmitted remotely.</div></div><form class="form" data-form><div class="fields"><div class="field"><label>Full name *</label><input required></div><div class="field"><label>Phone / WhatsApp *</label><input required></div><div class="field"><label>Email</label><input type="email"></div><div class="field"><label>Organization</label><input></div><div class="field full"><label>Inquiry type *</label><select required><option value="">Select one</option><option>BioVitalix B+</option><option>Black Soldier Fly systems</option><option>Hydroponics</option><option>Aeroponics</option><option>Aquaponics</option><option>Training</option><option>Consultancy</option><option>Research</option><option>Distribution</option><option>Investment or partnership</option></select></div>${quote?'<div class="field"><label>County / location</label><input></div><div class="field"><label>Budget range</label><select><option>Not yet determined</option><option>Below KSh 50,000</option><option>KSh 50,000–250,000</option><option>KSh 250,000–1,000,000</option><option>Above KSh 1,000,000</option></select></div>':''}<div class="field full"><label>Describe what you need *</label><textarea required></textarea></div><div class="field full"><label><input type="checkbox" required> I consent to MarinBio using this information to respond.</label></div></div><button class="btn btn-dark" type="submit">${quote?'Prepare quotation request':'Prepare inquiry'}</button><div class="success"></div></form></div></section>`}
function legal(title,text){return pageHero(title,'Important information governing use of MarinBio’s website and agricultural information.',images.soil)+`<section class="section"><article class="container article"><p>${text}</p><h2>Responsible use</h2><p>Website content is general information and does not replace crop-, site- and context-specific professional agronomic advice.</p><h2>Verification</h2><p>Scientific, regulatory, commercial and impact claims should only be treated as verified where MarinBio provides supporting documentation.</p></article></section>`}
function notFound(){return `<section class="section"><div class="container" style="padding-top:80px"><span class="eyebrow">404</span><h1>Page not found.</h1><p class="lead">Return to the homepage or explore MarinBio’s solution portfolio.</p><div class="btns"><a class="btn btn-dark" href="/">Go home</a><a class="btn btn-line" href="/solutions">View solutions</a></div></div></section>`}
function render(){let path=location.pathname.replace(/\/+$/,'')||'/';let html,title='MarinBio AgritechSolutions';if(path==='/')html=home();else if(path==='/about'){html=about();title='About | MarinBio'}else if(path==='/biovitalix'){html=biovitalix();title='BioVitalix B+ | MarinBio'}else if(path==='/solutions'){html=solutionsPage();title='Solutions | MarinBio'}else if(path.startsWith('/solutions/')){const slug=path.split('/').pop();html=solution(slug);title=(solutions[slug]?.title||'Solution')+' | MarinBio'}else if(path==='/technology'){html=technology();title='Technology | MarinBio'}else if(path==='/projects'){html=projects();title='Projects | MarinBio'}else if(path==='/research'){html=research();title='Research | MarinBio'}else if(path==='/insights'){html=insights();title='Insights | MarinBio'}else if(path.startsWith('/insights/')){const slug=path.split('/').pop();html=article(slug);title=(articles.find(x=>x.slug===slug)?.title||'Insight')+' | MarinBio'}else if(path==='/gallery'){html=gallery();title='Gallery | MarinBio'}else if(path==='/contact'){html=formPage('contact');title='Contact | MarinBio'}else if(path==='/request-quotation'){html=formPage('quote');title='Request a Quotation | MarinBio'}else if(path==='/privacy-policy'){html=legal('Privacy Policy','MarinBio will use submitted personal information to respond to inquiries, manage requested services and maintain necessary business records.');title='Privacy Policy | MarinBio'}else if(path==='/terms-of-use'){html=legal('Terms of Use','Website information does not create a contract, quotation, scientific guarantee or professional agronomic relationship. Final scopes and prices require written agreement.');title='Terms of Use | MarinBio'}else if(path==='/product-disclaimer'){html=legal('Product Disclaimer','Agricultural results depend on crop, soil, climate, dosage, application practices and farm-management conditions. BioVitalix claims must remain aligned with verified evidence and regulatory status.');title='Product Disclaimer | MarinBio'}else html=notFound();document.title=title;document.getElementById('app').innerHTML=html;bind()}
function bind(){const menu=document.querySelector('.menu'),mobile=document.querySelector('.mobile');menu.onclick=()=>mobile.classList.toggle('open');document.querySelectorAll('.mobile a').forEach(a=>a.onclick=()=>mobile.classList.remove('open'));document.querySelectorAll('[data-form]').forEach(f=>f.onsubmit=e=>{e.preventDefault();const ref='MB-'+Date.now().toString().slice(-8);const box=f.querySelector('.success');box.style.display='block';box.textContent='Inquiry prepared successfu